<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.StudyMate" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="materialAlertDialogTheme">@style/RoundedConfirmationDialog</item>
    </style>

    <style name="Theme.StudyMate" parent="Base.Theme.StudyMate" />

    <style name="FloatingLabelAppearance" parent="TextAppearance.Design.Hint">
        <item name="android:textColor">@color/purple_primary</item>
    </style>

    <style name="ErrorTextAppearance" parent="TextAppearance.Design.Error">
        <item name="android:textColor">@color/error_red</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ShapeAppearance.StudyMate.FAB" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Theme for Confirmation Dialogs (Exit, Delete, etc.) -->
    <style name="RoundedConfirmationDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearance">@style/ConfirmationShape</item>
        <item name="shapeAppearanceOverlay">@style/ConfirmationShape</item>
        <item name="colorAccent">@color/purple_primary</item>
        <item name="colorSurface">@color/white</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="buttonBarPositiveButtonStyle">@style/ConfirmationButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/ConfirmationButtonStyle</item>
    </style>

    <style name="ConfirmationShape" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ConfirmationButtonStyle" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/purple_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- KEEP THIS EXACTLY AS IS FOR ADD/EDIT TASK DIALOGS -->
    <style name="CustomDialogTheme" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowElevation">8dp</item>
        <item name="shapeAppearance">@style/CustomDialogShapeAppearance</item>
        <item name="shapeAppearanceOverlay">@style/CustomDialogShapeAppearance</item>
        <item name="autoCompleteTextViewStyle">@style/CustomAutoCompleteTextViewStyle</item>
        <item name="android:dropDownListViewStyle">@style/CustomDropDownListViewStyle</item>
    </style>

    <style name="CustomDialogShapeAppearance" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50dp</item>
    </style>

    <style name="CustomAutoCompleteTextViewStyle" parent="Widget.AppCompat.AutoCompleteTextView">
        <item name="android:popupBackground">@drawable/bg_dropdown_popup</item>
        <item name="android:dropDownVerticalOffset">2dp</item>
    </style>

    <style name="CustomDropDownListViewStyle" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:divider">@android:color/transparent</item>
        <item name="android:dividerHeight">0dp</item>
        <item name="android:background">@color/white</item>
        <item name="android:listSelector">@android:color/transparent</item>
    </style>

    <style name="CustomDatePickerTheme" parent="ThemeOverlay.MaterialComponents.MaterialCalendar.Fullscreen">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
    </style>
</resources>